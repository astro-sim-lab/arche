# Editor defaults for the arche sources.
# See .clang-format for the authoritative C/C++ formatting rules.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{h,hpp,c,cc,cpp}]
indent_size = 2
max_line_length = 80

[*.py]
indent_size = 4

[*.{sh,conf}]
indent_size = 2

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false
